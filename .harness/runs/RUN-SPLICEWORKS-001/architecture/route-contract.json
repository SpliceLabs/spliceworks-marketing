          "file": "(machine)/llms-full.txt/route.ts",
          "method": "GET",
          "contentType": "text/plain; charset=utf-8"
        },

        "generation": {
          "timing": "build",
          "sources": [
            "content/pages/**/*.md",
            "content/data/**/*.json"
          ],
          "template": "templates/llms-full.txt"
        },

        "caching": {
          "strategy": "static",
          "revalidate": false
        }
      },

