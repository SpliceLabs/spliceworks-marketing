      {
        "path": "/api/contact-schema",
        "name": "contact-schema",
        "type": "route-handler",
        "purpose": "Structured intake schema for agents",

        "handler": {
          "file": "api/contact-schema/route.ts",
          "method": "GET",
          "contentType": "application/schema+json"
        },

        "generation": {
          "timing": "static",
          "source": "ContactFormData schema"
        },

        "caching": {
          "strategy": "static",
          "revalidate": false
        }
      }
    ],

    "api": [
      {
        "path": "/api/contact",
        "name": "contact-submit",
        "type": "route-handler",
        "purpose": "Contact form submission handler",

        "handler": {
          "file": "api/contact/route.ts",
          "method": "POST",
          "contentType": "application/json"
        },

        "request": {
          "schema": "ContactFormData",
          "validation": "zod"
        },

        "response": {
          "success": {
            "status": 200,
            "body": { "success": true, "message": "We'll be in touch." }
          },
          "error": {
            "status": 400,
            "body": { "success": false, "errors": [] }
          }
        },

        "destination": {
          "type": "webhook",
          "env": "CONTACT_WEBHOOK_URL",
          "fallback": {
            "type": "email",
            "env": "CONTACT_EMAIL_TO"
          }
        }
      }
