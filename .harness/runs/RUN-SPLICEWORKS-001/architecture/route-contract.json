    "machine": [
      {
        "path": "/llms.txt",
        "name": "llms-summary",
        "type": "route-handler",
        "purpose": "AI-readable site summary",

        "handler": {
          "file": "(machine)/llms.txt/route.ts",
          "method": "GET",
          "contentType": "text/plain; charset=utf-8"
        },

        "generation": {
          "timing": "build",
          "sources": [
            "content/SOURCE-OF-TRUTH.md",
            "content/SITEMAP.md"
          ],
          "template": "templates/llms-summary.txt"
