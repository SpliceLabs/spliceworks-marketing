{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asset Manifest",
  "description": "Maps design system assets to production destinations",
  "type": "object",
  "required": ["version", "generatedAt", "logos", "favicons", "fonts", "templates"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "designSystemPath": {
      "type": "string",
      "description": "Path to design system source"
    },
    "logos": {
      "type": "object",
      "description": "Logo assets with theme variants",
      "properties": {
        "mark": {
          "$ref": "#/$defs/themedAsset"
        },
        "lockupHorizontal": {
          "$ref": "#/$defs/themedAsset"
        },
        "lockupVertical": {
          "$ref": "#/$defs/themedAsset"
        },
        "lockupEndorsed": {
          "$ref": "#/$defs/themedAsset"
        },
        "avatar": {
          "$ref": "#/$defs/themedAsset"
        },
        "seal": {
          "$ref": "#/$defs/themedAsset"
        }
      }
    },
    "favicons": {
      "type": "array",
      "description": "Favicon assets for different contexts",
      "items": {
        "type": "object",
        "required": ["source", "destination", "size"],
        "properties": {
          "source": {
            "type": "string",
            "description": "Path relative to design system"
          },
          "destination": {
            "type": "string",
            "description": "Path in public/ folder"
          },
          "size": {
            "type": "integer"
          },
          "purpose": {
            "type": "string",
            "enum": ["favicon", "apple-touch-icon", "android-chrome", "og-image"]
          }
        }
      }
    },
    "fonts": {
      "type": "array",
      "description": "Font definitions",
      "items": {
        "type": "object",
        "required": ["family", "source"],
        "properties": {
          "family": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": ["google-fonts", "local", "cdn"]
          },
          "url": {
            "type": "string"
          },
          "weights": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "styles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["normal", "italic"]
            }
          },
          "variable": {
            "type": "boolean"
          }
        }
      }
    },
    "templates": {
      "type": "array",
      "description": "HTML templates requiring React conversion",
      "items": {
        "type": "object",
        "required": ["source", "outputComponent", "usedOnRoutes"],
        "properties": {
          "source": {
            "type": "string",
            "description": "Path to HTML template"
          },
          "outputComponent": {
            "type": "string",
            "description": "Path for generated React component"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "usedOnRoutes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Supporting files needed (JS, CSS)"
          },
          "props": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "description": "Design system components to use directly",
      "items": {
        "type": "object",
        "required": ["name", "source"],
        "properties": {
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": ["core", "forms", "display", "overlay"]
          },
          "needsConversion": {
            "type": "boolean",
            "description": "True if JSX needs TypeScript conversion"
          }
        }
      }
    }
  },
  "$defs": {
    "themedAsset": {
      "type": "object",
      "required": ["light", "dark"],
      "properties": {
        "light": {
          "type": "object",
          "required": ["source", "destination"],
          "properties": {
            "source": {
              "type": "string"
            },
            "destination": {
              "type": "string"
            }
          }
        },
        "dark": {
          "type": "object",
          "required": ["source", "destination"],
          "properties": {
            "source": {
              "type": "string"
            },
            "destination": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
