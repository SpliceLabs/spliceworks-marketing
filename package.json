{
  "name": "spliceworks-marketing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-tbd.mjs --build && next build",
    "start": "next start",
    "lint": "eslint",
    "check:tbd": "node scripts/check-tbd.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.30.3",
  "simple-git-hooks": {
    "pre-commit": "pnpm lint && pnpm type-check && pnpm test"
  }
}
